{
  "name": "worldcup-soren-predictor",
  "description": "World Cup 2026 prediction dashboard: a Poisson-model forecast scored against actual results (archived read-only).",
  "author": "Lim Jia Quan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livejiaquan/worldcup-soren-predictor.git"
  },
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://worldcup.kyasen.com/",
  "scripts": {
    "dev": "vite",
    "update-data": "node scripts/update-data.mjs",
    "archive-summary": "node scripts/archive-summary.mjs",
    "validate": "node scripts/validate-data.mjs",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build": "npm test && npm run validate && GITHUB_REPOSITORY=livejiaquan/worldcup-soren-predictor vite build && npm run validate:deploy",
    "lint": "oxlint src scripts vite.config.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^0.552.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.69.0"
  }
}
